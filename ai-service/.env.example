# === AI Service (Laptop 1) ===

# WebSocket server binds to all interfaces so Laptop 2 can connect
AI_SERVER_HOST=0.0.0.0
AI_SERVER_PORT=8001

# Set to true to run without a camera (publishes simulated events)
TEST_MODE=false

# Heartbeat interval in seconds
HEARTBEAT_INTERVAL_SECONDS=2

# Camera settings
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
