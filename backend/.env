# === Backend (Laptop 2) ===

# Database (SQLite for development — switch to PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./smartdrive.db
DATABASE_URL_SYNC=sqlite:///./smartdrive.db

# AI Service connection (127.0.0.1 for single-laptop dev; change to Laptop 1 LAN IP e.g. 192.168.1.X for 2 laptops)
AI_SERVER_HOST=127.0.0.1
AI_SERVER_PORT=8001
AI_HEARTBEAT_TIMEOUT_SECONDS=8
AI_RECONNECT_BACKOFF_SECONDS=2,5,10,20

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Security
SECRET_KEY=change-me-to-a-random-secret-key-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# SMS / Highway Assistance Notification (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TOLL_ASSISTANCE_PHONE_NUMBER=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_WEBHOOK_VALIDATE_SIGNATURE=false
