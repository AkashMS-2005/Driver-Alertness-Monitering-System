# === Backend (Laptop 2) ===

# Database
DATABASE_URL=postgresql+asyncpg://smartdrive:smartdrive_secret@localhost:5432/smartdrive_guardian
DATABASE_URL_SYNC=postgresql://smartdrive:smartdrive_secret@localhost:5432/smartdrive_guardian

# AI Service connection (set to the actual IP of Laptop 1)
AI_SERVER_HOST=192.168.1.101
AI_SERVER_PORT=8001
AI_HEARTBEAT_TIMEOUT_SECONDS=8
AI_RECONNECT_BACKOFF_SECONDS=2,5,10,20

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Security
SECRET_KEY=change-me-to-a-random-secret-key-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
